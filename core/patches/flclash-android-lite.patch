+            child: SizedBox(
+              width: powerSize,
+              height: powerSize,
+              child: Stack(
+                alignment: Alignment.center,
+                children: [
+                  CustomPaint(
+                    size: Size(powerSize, powerSize),
+                    painter: _PowerRingPainter(
+                      start: scheme.primary,
+                      end: const Color(0xFF2BB9C4),
+                    ),
+                  ),
+                  Container(
+                    width: powerSize * .816,
+                    height: powerSize * .816,
+                    decoration: BoxDecoration(
+                      shape: BoxShape.circle,
+                      gradient: RadialGradient(
+                        colors: [
+                          on ? scheme.primary : scheme.primaryContainer,
+                          on ? scheme.primary.withValues(alpha: .78) : scheme.primary.withValues(alpha: .72),
+                        ],
+                      ),
+                      boxShadow: on
+                          ? [BoxShadow(color: scheme.primary.withValues(alpha: .26), blurRadius: 30)]
+                          : null,
+                    ),
+                  ),
+                  Container(
+                    width: powerSize * .622,
+                    height: powerSize * .622,
+                    decoration: BoxDecoration(
+                      shape: BoxShape.circle,
+                      color: on ? scheme.primaryContainer : scheme.surfaceContainerHigh,
+                    ),
+                  ),
+                  connecting
+                      ? CircularProgressIndicator(color: scheme.primary)
+                      : Icon(Icons.power_settings_new_rounded, size: powerSize * .24,
+                          color: on ? scheme.onPrimaryContainer : scheme.primary.withValues(
+                              alpha: profiles.profiles.isEmpty ? .45 : 1)),
+                ],
+              ),
+            ),
+          ),
+        ),
+        if (profiles.profiles.isNotEmpty) ...[
+          const SizedBox(height: 8),
+          Text(
+            connecting
+                ? appLocalizations.connecting
+                : on ? appLocalizations.connected : appLocalizations.disconnected,
+            style: Theme.of(context).textTheme.titleMedium?.copyWith(fontWeight: FontWeight.w700),
+          ),
+        ],
+        if (on)
+          Text(utils.getTimeText(ref.watch(runTimeProvider)),
+              style: Theme.of(context).textTheme.labelSmall?.copyWith(color: scheme.onSurfaceVariant)),
+        const SizedBox(height: 16),
+        if (profiles.profiles.isNotEmpty) ...[
