+/// The main Android layout follows the hierarchy of Happ's connection page:
+/// a centered power control, compact utility actions, subscription list and
+/// two import actions anchored at the bottom. All artwork is drawn in Flutter.
+class HappHomeView extends ConsumerWidget {
+  const HappHomeView({super.key});
+
+  Future<void> _scan(BuildContext context) async {
+    final value = await BaseNavigator.push(context, const ScanPage());
